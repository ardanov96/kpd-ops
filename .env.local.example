# ============================================================
# Neon.tech / PostgreSQL
# ============================================================
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
DEFAULT_OWNER_PASSWORD=Admin123456

# ============================================================
# Session Secret (HMAC signing untuk cookie session_user)
# ============================================================
# Generate dengan: openssl rand -hex 32
# WAJIB di-set di production. Tanpa secret, cookie bisa di-spoof
# oleh siapapun via browser devtools.
# (Di dev, fallback default dipakai jika kosong — TIDAK aman.)
SESSION_SECRET=

# ============================================================
# Cek Ongkir (use.api.co.id regional + expedition API)
# ============================================================
# Daftar gratis di https://use.api.co.id utk mendapatkan API key.
# Endpoint dipakai:
#   GET /regional/indonesia/districts?name=...    (cari kecamatan)
#   GET /regional/indonesia/villages?district_code=...  (list kelurahan)
#   GET /expedition/shipping-cost?origin=...&destination=...&weight=...  (tarif)
# Tanpa key ini, fitur Cek Ongkir tdk berfungsi.
APICOOID_KEY=

# ============================================================
# Supabase (Legacy / Optional)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Cron Secret (untuk proteksi endpoint cron)
# ============================================================
# Generate dengan: openssl rand -hex 32
# Set di Vercel Environment Variables, lalu:
#   - Cron job pakai header: Authorization: Bearer <CRON_SECRET>
#   - Di local dev, kosongkan atau disable agar same-origin POST dari UI diizinkan
CRON_SECRET=

# ============================================================
# Backup ke S3 (Sprint 5+)
# ============================================================
# Endpoint: /api/admin/backup
# Dipanggil via Vercel Cron harian (jam 23:00 UTC)
#
# Generate S3 bucket + IAM access key di AWS Console:
#   1. Buat bucket (e.g. "ekspedisi-backups")
#   2. IAM → User → Attach policy: AmazonS3PutObjectOnly
#   3. Copy Access Key ID & Secret Access Key
#
# Format SUPABASE_DB_URL:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# (lihat Supabase Dashboard → Settings → Database → Connection string → Transaction pooler)
SUPABASE_DB_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_CRON_SECRET=

# ============================================================
# Optional: PDF fonts (untuk Sprint 5 export PDF)
# ============================================================
# @react-pdf/renderer butuh font registered. Default pakai Helvetica.
# Untuk custom font (mis. untuk cetak SPT), register di src/lib/export/pdf.tsx