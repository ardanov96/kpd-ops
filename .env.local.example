# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret (optional, untuk proteksi endpoint cron)
# Generate dengan: openssl rand -hex 32
# Set di Vercel Environment Variables, lalu:
#   - Cron job pakai header: Authorization: Bearer <CRON_SECRET>
#   - Di local dev, kosongkan atau disable agar same-origin POST dari UI diizinkan
CRON_SECRET=
